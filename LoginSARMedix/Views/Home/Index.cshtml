
@* SM-ORBITA-METADATA *@
@{
    ViewData["SmScreen"] = "Index";
    ViewData["SmFamily"] = "access";
}

@model LoginSARMedix.Models.Usuario

@{
    string mensajeExito =
        TempData["Mensaje"]?.ToString() ?? "";

    string mensajeError =
        ViewBag.Mensaje?.ToString() ?? "";
}

<!-- =========================================
     INICIO DE SESION - ORBITA 2.0
     ========================================= -->

<section class="orbit-access">

    <!-- PANEL IZQUIERDO -->

    <aside class="orbit-access-brand">

        <span class="orbit-eyebrow">
            SARMedix / ÓRBITA 2.0
        </span>

        <div class="orbit-access-art" aria-hidden="true">
            <partial name="_OrbitInstrument" />
        </div>

        <h1>
            Todo conectado.
            <br />
            Mejor cuidado.
        </h1>

        <p>
            Tu espacio de trabajo farmacéutico.
        </p>

    </aside>


    <!-- PANEL DERECHO -->

    <div class="orbit-access-fields">

        <h2>
            Inicio de sesión SARMedix
        </h2>

        <form asp-controller="Home"
              asp-action="InicioSesion"
              method="post"
              class="formulario-principal orbit-login-form"
              data-orbit-form="Index">

            <!-- =================================
                 MENSAJES
                 ================================= -->

            <div class="espacio-mensaje">

                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="mensaje mensaje-exito"
                         id="mensajeLogin">

                        <span class="mensaje-icono">
                            ✓
                        </span>

                        <span>
                            @mensajeExito
                        </span>

                    </div>
                }
                else if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="mensaje mensaje-error"
                         id="mensajeLogin">

                        <span class="mensaje-icono">
                            !
                        </span>

                        <span>
                            @mensajeError
                        </span>

                    </div>
                }
                else
                {
                    <div class="mensaje-vacio"></div>
                }

            </div>


            <!-- =================================
                 NOMBRE DE USUARIO
                 ================================= -->

            <div class="orbit-login-campo">

                <label for="nombre_usuario">
                    Nombre de usuario
                </label>

                <input asp-for="nombre_usuario"
                       autocomplete="username" />

            </div>


            <!-- =================================
                 CONTRASEÑA
                 ================================= -->

            <div class="orbit-login-campo">

                <label for="contrasena">
                    Contraseña
                </label>

                <input asp-for="contrasena"
                       type="password"
                       autocomplete="current-password" />

            </div>


            <!-- =================================
                 BOTONES DEL FORMULARIO
                 ================================= -->

            <div class="orbit-login-acciones">

                <!-- INICIAR SESION -->

                <button type="submit"
                        class="orbit-login-boton"
                        data-orbit-action="primary">

                    Iniciar sesión

                </button>


                <!-- RECUPERAR CONTRASEÑA -->

                <a asp-controller="Home"
                   asp-action="RecuperarContrasena"
                   class="orbit-login-recuperar"
                   data-orbit-action="secondary">

                    ¿Olvidaste tu contraseña?

                </a>

            </div>

        </form>

    </div>

</section>


<!-- =========================================
     ESTILOS EXCLUSIVOS DEL LOGIN
     ========================================= -->

<style>

    /* CONTENEDOR GENERAL */

    body.sm-app[data-sm-screen="Index"] .orbit-access {
        width: min(1040px, 100%);
        max-width: 100%;
    }

    body.sm-app[data-sm-screen="Index"] .orbit-access-fields {
        min-width: 0;
    }


    /* =========================================
       FORMULARIO
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-access-fields .orbit-login-form {

        display: flex !important;

        flex-direction: column !important;

        align-items: stretch !important;

        justify-content: flex-start !important;

        gap: 18px !important;

        position: relative !important;

        width: 100% !important;

        max-width: 100% !important;

        min-width: 0 !important;

        height: auto !important;

        min-height: 0 !important;

        margin: 0 !important;

        padding: 0 !important;

        background: transparent !important;

        box-shadow: none !important;

        border: none !important;

    }


    /* =========================================
       CAMPOS
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .orbit-login-campo {

        display: flex !important;

        flex-direction: column !important;

        position: static !important;

        width: 100% !important;

        min-width: 0 !important;

        margin: 0 !important;

        padding: 0 !important;

        gap: 7px;

    }


    /* ETIQUETAS */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .orbit-login-campo label {

        display: block;

        position: static !important;

        margin: 0 !important;

        color: #24476e;

        font-size: 14px;

        font-weight: 600;

        text-align: left;

    }


    /* INPUTS */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .orbit-login-campo input {

        display: block !important;

        position: static !important;

        width: 100% !important;

        max-width: 100% !important;

        min-width: 0 !important;

        min-height: 46px;

        margin: 0 !important;

        padding: 11px 14px;

        border: 1px solid #b9cde8;

        border-radius: 10px;

        background-color: #fbfdff;

        color: #203f63;

        font-size: 15px;

        box-sizing: border-box;

    }


    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .orbit-login-campo input:focus {

        outline: none;

        border-color: #3277df;

        box-shadow: 0 0 0 3px rgba(50, 119, 223, 0.12);

    }


    /* =========================================
       CONTENEDOR DE BOTONES
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .orbit-login-acciones {

        display: flex !important;

        flex-direction: column !important;

        align-items: stretch !important;

        justify-content: flex-start !important;

        position: static !important;

        width: 100% !important;

        min-width: 0 !important;

        height: auto !important;

        min-height: 0 !important;

        margin: 8px 0 0 !important;

        padding: 0 !important;

        gap: 14px !important;

        box-sizing: border-box;

    }


    /* =========================================
       AMBOS BOTONES
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-boton,

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-recuperar {

        display: flex !important;

        flex: 0 0 auto !important;

        align-items: center !important;

        justify-content: center !important;

        position: static !important;

        inset: auto !important;

        float: none !important;

        clear: both !important;

        transform: none !important;

        width: 100% !important;

        max-width: 100% !important;

        min-width: 0 !important;

        height: auto !important;

        min-height: 46px !important;

        margin: 0 !important;

        padding: 12px 16px !important;

        border-radius: 10px !important;

        box-sizing: border-box !important;

        text-align: center !important;

        text-decoration: none !important;

        font-size: 14px !important;

        font-weight: 600 !important;

        line-height: 1.4 !important;

        white-space: normal !important;

        cursor: pointer;

    }


    /* =========================================
       BOTON INICIAR SESION
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-boton {

        background: linear-gradient(
            130deg,
            #326fe4,
            #2253bd
        ) !important;

        border: 1px solid #245ac7 !important;

        color: white !important;

    }


    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-boton:hover {

        background: linear-gradient(
            130deg,
            #285ed4,
            #1c469f
        ) !important;

        box-shadow: 0 5px 15px rgba(35, 84, 174, 0.18) !important;

    }


    /* =========================================
       RECUPERAR CONTRASEÑA
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-recuperar {

        background: #f1f6ff !important;

        border: 1px solid #b9cdeb !important;

        color: #254e85 !important;

    }


    body.sm-app[data-sm-screen="Index"]
    .orbit-login-acciones > .orbit-login-recuperar:hover {

        background: #e5efff !important;

        border-color: #97b6e8 !important;

        color: #173e78 !important;

        box-shadow: 0 4px 12px rgba(35, 84, 174, 0.08) !important;

    }


    /* =========================================
       ESPACIO PARA MENSAJES
       ========================================= */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .espacio-mensaje {

        position: static !important;

        width: 100% !important;

        min-height: 55px;

        height: auto !important;

        margin: 0 !important;

        padding: 0 !important;

        box-sizing: border-box;

    }


    /* MENSAJE GENERAL */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje {

        width: 100%;

        min-height: 48px;

        padding: 11px 14px;

        box-sizing: border-box;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 10px;

        border-radius: 8px;

        text-align: center;

        font-size: 14px;

        font-weight: 600;

        opacity: 1;

        transition: opacity 0.5s ease;

    }


    /* MENSAJE EXITO */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-exito {

        background-color: #d1e7dd;

        color: #0f5132;

        border: 1px solid #badbcc;

    }


    /* MENSAJE ERROR */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-error {

        background-color: #f8d7da;

        color: #842029;

        border: 1px solid #f5c2c7;

    }


    /* ICONO MENSAJE */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-icono {

        width: 24px;

        height: 24px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 50%;

        font-size: 15px;

        font-weight: bold;

    }


    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-exito .mensaje-icono {

        background-color: #198754;

        color: white;

    }


    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-error .mensaje-icono {

        background-color: #dc3545;

        color: white;

    }


    /* ESPACIO VACIO */

    body.sm-app[data-sm-screen="Index"]
    .orbit-login-form .mensaje-vacio {

        width: 100%;

        height: 48px;

    }

</style>


<!-- =========================================
     SCRIPT ORIGINAL DE MENSAJES
     ========================================= -->

<script>

    // OCULTAR MENSAJE DESPUES DE 3 SEGUNDOS

    setTimeout(
        function () {

            const mensaje =
                document.getElementById("mensajeLogin");

            if (mensaje) {

                mensaje.style.opacity = "0";

                setTimeout(
                    function () {

                        mensaje.style.visibility = "hidden";

                    },
                    500
                );

            }

        },
        3000
    );

</script>
